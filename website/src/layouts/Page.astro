---
import regularFont from '../assets/fonts/satoma-sans-400-latin.woff2?url';
import headingFont from '../assets/fonts/satoma-sans-600-latin.woff2?url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Stillmic: just your voice',
  description = 'Removes the fan, the keyboard and the street from your Mac’s microphone, in every app. Free, open source, and it never leaves your Mac.',
} = Astro.props;
const repo = 'https://github.com/robin-liquidium/stillmic';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#f6f5f0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0d121f"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link
      rel="preload"
      href={regularFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={headingFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://stillmic.robin.build/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="shell">
      <header>
        <a class="brand" href="/" aria-label="Stillmic home">
          <img src="/icon.png" width="34" height="34" alt="" />
          Stillmic
        </a>
        <nav aria-label="Main navigation">
          <a href="/changelog">Changelog</a>
          <a href={repo}>GitHub</a>
        </nav>
      </header>
      <slot />
      <footer>
        <span>
          Made by <a href="https://robin.build">Robin</a>. Also behind{' '}
          <a href="https://dayline.robin.build">Dayline</a> and{' '}
          <a href="https://buds.robin.build">Redmi Buds Bar</a>.
        </span>
        <div>
          <a href="/privacy">Privacy</a>
          <a href={`${repo}/issues`}>Help & feedback</a>
        </div>
        <p>
          Noise removal by{' '}
          <a href="https://github.com/Rikorose/DeepFilterNet">DeepFilterNet</a>.
          Began as a fork of{' '}
          <a href="https://github.com/ivalsaraj/NoNoise-Mac">NoNoise-Mac</a>.
          MIT licensed.
        </p>
      </footer>
    </div>
  </body>
</html>
