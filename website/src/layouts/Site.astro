---
import Page from '@robin-build/landing-kit/Page.astro';
import type { Site } from '@robin-build/landing-kit/projects';
import '@robin-build/landing-kit/design.css';
import '../styles/site.css';
import release from '../../../release.json';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const repo = 'https://github.com/robin-liquidium/stillmic';
const site: Site = {
  id: 'stillmic',
  name: 'Stillmic',
  url: 'https://stillmic.robin.build',
  icon: '/icon.png',
  themeColor: { light: '#f6f5f0', dark: '#0d121f' },
  ogImage: 'https://stillmic.robin.build/og.png',
  ogImageAlt: 'Stillmic: just your voice.',
  cta: { label: 'Download', href: '/download' },
  app: {
    operatingSystem: 'macOS 15 or later (Apple silicon)',
    category: 'UtilitiesApplication',
    downloadUrl: 'https://stillmic.robin.build/download',
    version: release.version,
  },
  nav: [
    { label: 'Listen', href: '/#listen' },
    { label: 'How it works', href: '/#how' },
    { label: 'Questions', href: '/#questions' },
    { label: 'Changelog', href: '/changelog' },
  ],
  footerLinks: [
    { label: 'Privacy', href: '/privacy' },
    { label: 'GitHub', href: repo },
    { label: 'Help & feedback', href: `${repo}/issues` },
  ],
};
const {
  title = 'Stillmic: free noise removal for your Mac’s microphone',
  description = 'Stillmic removes fan, keyboard and street noise from your Mac’s microphone in Zoom, Meet, Slack and every other app. Free, open source, and your audio never leaves your Mac.',
  noindex,
} = Astro.props;
---

<Page site={site} title={title} description={description} noindex={noindex}>
  <slot />
  <Fragment slot="credits">
    Noise removal by{' '}
    <a href="https://github.com/Rikorose/DeepFilterNet">DeepFilterNet</a>. Began
    as a fork of{' '}
    <a href="https://github.com/ivalsaraj/NoNoise-Mac">NoNoise-Mac</a>. MIT
    licensed.
  </Fragment>
</Page>
