---
import Demo from '../components/Demo.astro';
import DownloadIcon from '@robin-build/landing-kit/components/DownloadIcon.astro';
import Faq from '@robin-build/landing-kit/components/Faq.astro';
import Features from '@robin-build/landing-kit/components/Features.astro';
import Stats from '@robin-build/landing-kit/components/Stats.astro';
import Flow from '../components/Flow.astro';
import Site from '../layouts/Site.astro';
import release from '../../../release.json';

const stats = [
  { value: '~8%', label: 'of one CPU core, on a real call' },
  { value: '~23 MB', label: 'of memory while you talk' },
  { value: '0.0%', label: 'CPU measured when no app is using the mic' },
  { value: '0 bytes', label: 'of your audio leave your Mac' },
];

const features = [
  {
    tag: '01 / Everywhere',
    title: 'Works in every app.',
    text: 'Zoom, Meet, Slack, Discord, your browser. If an app lets you choose a microphone, Stillmic works there.',
  },
  {
    tag: '02 / Private',
    title: 'Stays on your Mac.',
    text: 'Your voice is cleaned on your Mac and never stored or sent anywhere. No account and no analytics.',
  },
  {
    tag: '03 / Idle',
    title: 'Idle means idle.',
    text: 'The noise engine only runs while an app is using the Stillmic mic. The rest of the day it’s asleep and your real mic stays closed.',
  },
  {
    tag: '04 / Modes',
    title: 'Two strengths.',
    text: 'Standard keeps your voice smooth. Aggressive cuts harder between words. Switch from the menu bar at any time.',
  },
];

const faq = [
  {
    q: 'Does it clean up other people on the call?',
    a: 'No. Stillmic only cleans your microphone.',
  },
  {
    q: 'Why does it ask for my password?',
    a: 'Once, to install the virtual microphone, which macOS keeps in a system folder. All audio on your Mac stops for a moment while it loads.',
  },
  {
    q: 'What happens if I quit the app?',
    a: 'The Stillmic mic goes silent, so it never plays old audio. Pick your normal mic to stop using it, or leave Start at Login on.',
  },
  {
    q: 'Can I use Bluetooth earbuds as the mic?',
    a: 'You can, but Bluetooth mics usually drop your earbuds into lower-quality call audio. A built-in or USB mic generally sounds better.',
  },
  {
    q: 'What’s it built on?',
    a: 'DeepFilterNet3, an open-source speech model, hand-ported to C so it runs with no machine learning framework. The code is on GitHub under the MIT license.',
  },
];
---

<Site>
  <main id="main">
    <section class="hero">
      <span class="eyebrow">
        <span class="dot"></span> Noise removal for your Mac’s mic
      </span>
      <h1>
        Just your <em>voice.</em>
      </h1>
      <p class="intro">
        Stillmic takes the fan, the keyboard and the street
        <br class="desktop" /> out of your microphone, in every app, right on
        your Mac.
      </p>
      <div class="actions">
        <a class="button primary" href="/download">
          <DownloadIcon />
          Download for Mac
        </a>
        <a class="text-link" href="#listen">
          Hear the difference
        </a>
      </div>
      <p class="small">
        Free & open source · macOS 15+ · Apple silicon · v{release.version}
      </p>
      <Demo />
    </section>

    <section class="stats" aria-label="How light it is">
      <div class="section-heading">
        <span class="eyebrow">How light it is</span>
        <h2>
          Light enough to <em>forget about.</em>
        </h2>
      </div>
      <Stats items={stats} />
      <p class="small">
        Measured on an M4 Pro. Yours will vary with your Mac and how much you
        talk. macOS’s own audio service uses some CPU on top.
      </p>
    </section>

    <section class="how">
      <div class="section-heading center">
        <span class="eyebrow">How it works</span>
        <h2>
          Pick it like <em>any other mic.</em>
        </h2>
        <p>
          Stillmic adds a microphone to your Mac. Choose it in your call app and
          everyone hears the clean version.
        </p>
      </div>
      <Flow />
    </section>

    <section>
      <Features items={features} />
    </section>

    <section class="faq">
      <h2>Questions.</h2>
      <Faq items={faq} />
    </section>

    <section class="install">
      <h2>
        Take the noise <br />
        <em>out of the call.</em>
      </h2>
      <a class="button primary" href="/download">
        <DownloadIcon />
        Download Stillmic
      </a>
      <p class="small">No account. No analytics. Just your voice.</p>
    </section>
  </main>
</Site>
